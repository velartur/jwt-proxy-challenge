<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio-desktop" type="device">
  <diagram id="application-architecture" name="1 · Application architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p1-title" value="jwt-proxy · application architecture" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="6" width="700" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="p1-subtitle" value="Async HTTP proxy (Python 3.12, aiohttp). Takes a POST, signs a JWT (HS512) and forwards the request upstream with the token in the x-my-jwt header." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="32" width="1000" height="18" as="geometry"/>
        </mxCell>

        <!-- Docker container (dashed) -->
        <mxCell id="p1-container" value="Docker container · image jwt-proxy:latest (python:3.12-slim) · user jwtproxy (uid 10001) · read-only root FS · cap_drop ALL · no-new-privileges · HEALTHCHECK GET /status" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontStyle=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="660" height="580" as="geometry"/>
        </mxCell>

        <!-- aiohttp application -->
        <mxCell id="p1-app" value="aiohttp web.Application · asyncio, one process, one thread · listens on 0.0.0.0:8080 inside the container, published as 127.0.0.1:${HTTP_PORT} on the host · client_max_size = MAX_BODY_BYTES" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="620" height="510" as="geometry"/>
        </mxCell>

        <mxCell id="p1-router" value="&lt;b&gt;Router&lt;/b&gt;&lt;br&gt;/status → GET / HEAD&lt;br&gt;/{tail} → POST only (else 405)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="195" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p1-status" value="&lt;b&gt;status()&lt;/b&gt;&lt;br&gt;started_at · uptime_seconds&lt;br&gt;requests_processed / failed / in_flight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="195" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p1-metrics" value="&lt;b&gt;Metrics&lt;/b&gt;&lt;br&gt;per-process counters&lt;br&gt;(monotonic uptime)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="195" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p1-e-status-metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;endFill=1;fontSize=9;" edge="1" parent="1" source="p1-status" target="p1-metrics">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- proxy handler -->
        <mxCell id="p1-proxy" value="&lt;b&gt;proxy_post()&lt;/b&gt; — one request, five steps" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="295" width="580" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="p1-s1" value="&lt;b&gt;1 · read body&lt;/b&gt;&lt;br&gt;&lt;br&gt;await request.read()&lt;br&gt;≤ MAX_BODY_BYTES,&lt;br&gt;otherwise 413" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="352" y="330" width="100" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p1-s2" value="&lt;b&gt;2 · pick user&lt;/b&gt;&lt;br&gt;&lt;br&gt;JSON body .user or .username,&lt;br&gt;fallback DEFAULT_USER&lt;br&gt;(body is never rejected)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="464" y="330" width="100" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p1-s3" value="&lt;b&gt;3 · sign JWT&lt;/b&gt;&lt;br&gt;&lt;br&gt;HS512 (PyJWT)&lt;br&gt;claims iat · jti · payload&lt;br&gt;secret from env" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="576" y="330" width="100" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p1-s4" value="&lt;b&gt;4 · headers&lt;/b&gt;&lt;br&gt;&lt;br&gt;strip hop-by-hop, Host, Content-Length, client x-my-jwt&lt;br&gt;add x-my-jwt · Via · X-Forwarded-For" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="688" y="330" width="100" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p1-s5" value="&lt;b&gt;5 · forward&lt;/b&gt;&lt;br&gt;&lt;br&gt;pooled ClientSession,&lt;br&gt;no redirects, no auto-decompress&lt;br&gt;timeout → 504 · error → 502" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="800" y="330" width="100" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p1-resp" value="response to the client: upstream status + reason · end-to-end headers (+ Via: 1.1 jwt-proxy) · body passed through unchanged (≤ MAX_RESPONSE_BYTES, otherwise 502) · counters updated" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="352" y="462" width="548" height="50" as="geometry"/>
        </mxCell>

        <!-- config -->
        <mxCell id="p1-config" value="&lt;b&gt;Config&lt;/b&gt; — environment → frozen dataclass, validated at start (the process refuses to start on bad values)&lt;br&gt;JWT_SECRET_HEX (required, hex → ≥ 64 bytes) · UPSTREAM_URL (default https://postman-echo.com) · HTTP_HOST / HTTP_PORT · UPSTREAM_TIMEOUT_SECONDS (10) · MAX_BODY_BYTES (1 MiB) · MAX_RESPONSE_BYTES (10 MiB) · DEFAULT_USER (anonymous) · LOG_LEVEL (INFO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="340" y="545" width="580" height="90" as="geometry"/>
        </mxCell>

        <!-- client and upstream -->
        <mxCell id="p1-client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;curl · application · test suite&lt;br&gt;&lt;br&gt;POST /post?x=1&lt;br&gt;{&quot;user&quot;: &quot;alice&quot;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="180" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p1-upstream" value="&lt;b&gt;Upstream&lt;/b&gt; (any dummy endpoint)&lt;br&gt;https://postman-echo.com&lt;br&gt;&lt;br&gt;receives POST /post?x=1 + body&lt;br&gt;echoes headers and body back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="330" width="220" height="110" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="p1-e1" value="POST /post?x=1&lt;br&gt;headers + body" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-client" target="p1-proxy">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-22"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-e2" value="same status · headers · body&lt;br&gt;+ Via: 1.1 jwt-proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-proxy" target="p1-client">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="22"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-e3" value="GET /status  (served by the proxy, never forwarded, not counted)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#6C8EBF;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-client" target="p1-status">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="76"/>
              <mxPoint x="655" y="76"/>
            </Array>
            <mxPoint as="offset" x="60" y="-11"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-e4" value="POST /post?x=1 + body&lt;br&gt;x-my-jwt: eyJhbGciOiJIUzUxMiIs…&lt;br&gt;Via: 1.1 jwt-proxy · X-Forwarded-For" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-proxy" target="p1-upstream">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="130" y="-62"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-e5" value="status · headers · body" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#82B366;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-upstream" target="p1-proxy">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="70" y="40"/>
          </mxGeometry>
        </mxCell>

        <!-- notes -->
        <mxCell id="p1-n1" value="&lt;b&gt;Answered by the proxy itself&lt;/b&gt;&lt;br&gt;405 · method ≠ POST (Allow: POST)&lt;br&gt;413 · body &gt; MAX_BODY_BYTES&lt;br&gt;502 · upstream unreachable, or response &gt; MAX_RESPONSE_BYTES&lt;br&gt;504 · upstream slower than UPSTREAM_TIMEOUT_SECONDS&lt;br&gt;&lt;br&gt;502/504 are counted in requests_failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="200" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p1-n2" value="&lt;b&gt;x-my-jwt — RFC 7519, HS512 (RFC 7518 §3.2)&lt;/b&gt;&lt;br&gt;header · {alg: HS512, typ: JWT}&lt;br&gt;iat · request time, NumericDate (whole seconds)&lt;br&gt;jti · 256-bit random nonce (secrets.token_hex)&lt;br&gt;payload · {&quot;user&quot;: &quot;alice&quot;, &quot;date&quot;: &quot;2026-11-22&quot;} (UTC date)&lt;br&gt;&lt;br&gt;secret · 128 hex chars → 64 bytes = 512 bits, the minimum the RFC requires for HS512 · read from the environment only · never logged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="200" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p1-n3" value="&lt;b&gt;Proxy rules — RFC 2616 (→ 7230/7231)&lt;/b&gt;&lt;br&gt;• hop-by-hop headers stripped both ways (§13.5.1), including the tokens named in Connection&lt;br&gt;• Via appended both ways (§14.45)&lt;br&gt;• Host rewritten to the upstream · Content-Length recomputed&lt;br&gt;• client-supplied x-my-jwt discarded&lt;br&gt;• redirects returned to the client, never followed&lt;br&gt;• bodies passed byte-for-byte, Content-Encoding intact&lt;br&gt;• 502 Bad Gateway / 504 Gateway Timeout (§10.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1040" y="495" width="220" height="175" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="aws-deployment" name="2 · AWS deployment (EC2, private-nat)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p2-title" value="jwt-proxy · AWS deployment — one EC2 instance, private subnet + NAT gateway, SSM-only access" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="6" width="1000" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="p2-subtitle" value="deploy/ec2/template.yaml (CloudFormation) + deploy/ec2/deploy.sh · nothing listens on the internet · the proxy is reached through Session Manager port forwarding" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="32" width="1100" height="18" as="geometry"/>
        </mxCell>

        <!-- groups (drawn first so they stay behind) -->
        <mxCell id="p2-cloud" value="AWS account · us-east-1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="890" height="690" as="geometry"/>
        </mxCell>
        <mxCell id="p2-vpc" value="VPC 172.31.0.0/16 (default VPC) · VPC Block Public Access = block-ingress (account guardrail)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#8C4FFF;fillColor=none;verticalAlign=bottom;align=left;spacingLeft=30;spacingBottom=4;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="650" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="p2-private" value="Private subnet 172.31.250.0/24 · us-east-1a · no public IPs · route 0.0.0.0/0 → NAT gateway" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=10;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#147EBA;fillColor=#E6F2F8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="490" y="140" width="340" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="p2-sg" value="Security group · inbound: none · outbound: tcp 443, tcp 80 only" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=10;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#DD3522;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#DD3522;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="505" y="185" width="310" height="455" as="geometry"/>
        </mxCell>
        <mxCell id="p2-public" value="Public subnet (default) · us-east-1a · route 0.0.0.0/0 → Internet gateway" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=10;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#248814;fillColor=#E9F3E6;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="140" width="220" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="p2-internet" value="Internet" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=none;strokeColor=#666666;dashed=1;fontStyle=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1230" y="390" width="170" height="270" as="geometry"/>
        </mxCell>

        <!-- laptop -->
        <mxCell id="p2-laptop" value="Developer laptop&lt;br&gt;AWS CLI · Session Manager plugin&lt;br&gt;make deploy-ec2 · tunnel-ec2 · update-ec2" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="78" height="78" as="geometry"/>
        </mxCell>

        <!-- control-plane services -->
        <mxCell id="p2-cfn" value="CloudFormation&lt;br&gt;stack jwt-proxy&lt;br&gt;deploy/ec2/template.yaml" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;fillColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2-s3" value="S3 · private bucket&lt;br&gt;source tarball (git archive HEAD)&lt;br&gt;Block Public Access on · 7-day expiry" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;" vertex="1" parent="1">
          <mxGeometry x="300" y="250" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2-ssm" value="Systems Manager&lt;br&gt;Session Manager · Run Command&lt;br&gt;IAM-authenticated, TLS" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="300" y="390" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2-iam" value="IAM role + instance profile&lt;br&gt;AmazonSSMManagedInstanceCore&lt;br&gt;+ s3:GetObject on the stack prefix" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;" vertex="1" parent="1">
          <mxGeometry x="300" y="590" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- instance contents -->
        <mxCell id="p2-ec2" value="EC2 t4g.micro · Amazon Linux 2023 (arm64)&lt;br&gt;IMDSv2 required · 8 GB gp3, encrypted" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="630" y="215" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2-docker" value="&lt;b&gt;Docker Engine · Compose v2 · Buildx&lt;/b&gt; (installed at first boot)&lt;br&gt;/opt/jwt-proxy (source) · .env root-only (umask 077)&lt;br&gt;image built on the instance: docker compose up -d --build" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="280" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p2-ctr" value="&lt;b&gt;jwt-proxy container&lt;/b&gt;&lt;br&gt;published 127.0.0.1:8080 → 8080 (host loopback only)&lt;br&gt;user jwtproxy · read-only FS · cap_drop ALL · no-new-privileges&lt;br&gt;restart: unless-stopped · HEALTHCHECK GET /status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="533" y="420" width="254" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p2-agent" value="&lt;b&gt;amazon-ssm-agent&lt;/b&gt; (on the host)&lt;br&gt;connects outbound on 443 · no SSH daemon · no inbound ports&lt;br&gt;sessions and Run Command flow over that channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="560" width="280" height="64" as="geometry"/>
        </mxCell>

        <!-- gateways -->
        <mxCell id="p2-nat" value="NAT gateway + Elastic IP&lt;br&gt;outbound only (~0.045 USD/h)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.nat_gateway;" vertex="1" parent="1">
          <mxGeometry x="955" y="430" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2-igw" value="Internet gateway" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1">
          <mxGeometry x="1105" y="430" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- internet -->
        <mxCell id="p2-upstream" value="&lt;b&gt;Upstream&lt;/b&gt;&lt;br&gt;https://postman-echo.com&lt;br&gt;receives POST + x-my-jwt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="420" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2-downloads" value="&lt;b&gt;Build-time downloads&lt;/b&gt;&lt;br&gt;Docker Hub · python:3.12-slim&lt;br&gt;PyPI · aiohttp, PyJWT&lt;br&gt;GitHub · Compose, Buildx plugins&lt;br&gt;Amazon Linux repos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="520" width="150" height="120" as="geometry"/>
        </mxCell>

        <!-- edges: laptop -> services -->
        <mxCell id="p2-e-cfn" value="① aws cloudformation deploy&lt;br&gt;(secret as NoEcho parameter)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-laptop" target="p2-cfn">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="83" y="140"/>
            </Array>
            <mxPoint as="offset" x="107" y="98"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-s3" value="② git archive HEAD&lt;br&gt;→ source tarball" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-laptop" target="p2-s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="115" y="280"/>
            </Array>
            <mxPoint as="offset" x="42" y="55"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-ssm" value="③ SSM session&lt;br&gt;port-forward 8080&lt;br&gt;shell · run-command" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-laptop" target="p2-ssm">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-28"/>
          </mxGeometry>
        </mxCell>

        <!-- edges: inside AWS -->
        <mxCell id="p2-e-cfn-vpc" value="creates subnet · route table · NAT + EIP · security group · role · instance&lt;br&gt;waits for cfn-signal (10 min); CREATE_COMPLETE only when /status answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#E7157B;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.083;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-cfn" target="p2-vpc">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="130" y="-20"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-s3-ec2" value="aws s3 cp (first boot, via NAT)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#7AA116;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-s3" target="p2-ec2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="280"/>
              <mxPoint x="420" y="245"/>
            </Array>
            <mxPoint as="offset" x="0" y="-12"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-iam-ec2" value="instance profile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#DD344C;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.83;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-iam" target="p2-ec2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="620"/>
              <mxPoint x="430" y="265"/>
            </Array>
            <mxPoint as="offset" x="0" y="0"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-ssm-agent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#E7157B;fontSize=10;startArrow=classic;startFill=1;endArrow=classic;endFill=1;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-ssm" target="p2-agent">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="420"/>
              <mxPoint x="460" y="592"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-docker-nat" value="outbound only&lt;br&gt;tcp 443 · tcp 80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-docker" target="p2-nat">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-20"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-nat-igw" value="Elastic IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#8C4FFF;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-nat" target="p2-igw">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-12"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-igw-upstream" value="POST +&lt;br&gt;x-my-jwt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#82B366;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-igw" target="p2-upstream">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-20"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-igw-downloads" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#666666;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-igw" target="p2-downloads">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1135" y="580"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- notes -->
        <mxCell id="p2-n1" value="&lt;b&gt;Why private-nat&lt;/b&gt;&lt;br&gt;VPC Block Public Access in block-ingress mode also blocks connections *initiated* through the Internet gateway by instances with public IPs; only NAT gateways and egress-only gateways pass. deploy.sh reads the BPA setting and picks this mode, instead of asking for a BPA exclusion. Without BPA, the same template deploys in public mode: instance in the public subnet, public IP used for outbound traffic only, security group still with no inbound rules (~6 USD/month instead of ~40)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="250" y="770" width="440" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p2-n2" value="&lt;b&gt;First boot (EC2 user-data)&lt;/b&gt;&lt;br&gt;1 · dnf install docker git aws-cfn-bootstrap&lt;br&gt;2 · Compose + Buildx CLI plugins (GitHub releases)&lt;br&gt;3 · fetch the source: S3 tarball (this deployment) or git clone of a public repo&lt;br&gt;4 · write .env (secret, upstream URL, HTTP_BIND=127.0.0.1), root-only&lt;br&gt;5 · docker compose up -d --build proxy&lt;br&gt;6 · poll http://127.0.0.1:8080/status, then cfn-signal → stack CREATE_COMPLETE (~6 min, mostly the NAT gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="710" y="770" width="430" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p2-n3" value="&lt;b&gt;Access from the laptop&lt;/b&gt;&lt;br&gt;make tunnel-ec2 → http://localhost:8080 → Session Manager → instance 127.0.0.1:8080&lt;br&gt;&lt;br&gt;deploy/ec2/deploy.sh shell → interactive shell (no SSH keys)&lt;br&gt;&lt;br&gt;make update-ec2 → Run Command: new tarball + docker compose up --build&lt;br&gt;&lt;br&gt;make destroy-ec2 → deletes the whole stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="190" height="210" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
